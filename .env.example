# Copier ce fichier en .env et l'adapter si besoin.

# Clé API Claude : https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium            # low | medium | high : profondeur de réflexion (et coût)
DATE_REFERENCE=2026-10-30T12:00 # date « du jour » du jeu de données

DATABASE_URL=postgresql://novatech:novatech@localhost:5432/novatech
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "
# DATA_DIR=Dataset/data
