{
  "flow": "assistant",
  "description": "NovaTech Assist : 40 questions du jeu de test, notées par contrôles automatiques et un juge Claude Opus 5.5.",
  "metrics": [
    {"id": "reussite", "label": "Réussite", "kind": "binary"},
    {"id": "couverture", "label": "Couverture", "kind": "float", "scale": 1},
    {"id": "fidelite", "label": "Fidélité", "kind": "binary"},
    {"id": "outil_ok", "label": "Bon outil", "kind": "binary"},
    {"id": "source_ok", "label": "Bonne source", "kind": "binary"},
    {"id": "sans_interdit", "label": "Sans interdit", "kind": "binary"}
  ],
  "perf_fields": [
    {"id": "latency_s", "label": "Latence", "unit": "s"},
    {"id": "tool_calls", "label": "Outils"},
    {"id": "cost_usd", "label": "Coût", "unit": "$"}
  ],
  "prices": {
    "claude-sonnet-5-5": {"in": 2.0, "out": 10.0},
    "claude-opus-5-5": {"in": 4.0, "out": 20.0},
    "claude-haiku-5-5": {"in": 0.1, "out": 0.5}
  },
  "harness_paths": [
    "novatech/evaluation/__main__.py",
    "novatech/evaluation/notation.py",
    "Dataset/evaluation/selection_40.json",
    "Dataset/evaluation/questions_test.json"
  ]
}
